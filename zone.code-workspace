{
    "folders": [{ "name": "donezone", "path": "." }],
    "settings": {
        "chat.disableAIFeatures": true,
        "debug.javascript.codelens.npmScripts": "never",
        "explorer.autoRevealExclude": {
            "**/.cache": true,
            "**/.git": true,
            "**/.venv": true,
            "**/build": true,
            "**/dist": true,
            "**/site-packages": true,
            ".gitignore": true,
        },
        "extensions.ignoreRecommendations": true,
        "files.exclude": {
            "**/.venv": true,
            "**/__pycache__": true,
            "**/node_modules": true,
            ".gitignore": true,
        },
        "git.openRepositoryInParentFolders": "never",
        "git.terminalAuthentication": false,
        "js/ts.tsc.autoDetect": "off",
        "npm.scriptHover": false,
        "python.terminal.activateEnvironment": false,
        "remote.autoForwardPorts": false,
        "remote.forwardOnOpen": false,
        "terminal.integrated.automationProfile.linux": {
            "args": ["--noprofile", "--norc"],
            "path": "/usr/bin/bash",
        },
        "terminal.integrated.defaultProfile.linux": "custom bash",
        "terminal.integrated.drawBoldTextInBrightColors": false,
        "terminal.integrated.enableFileLinks": "off",
        "terminal.integrated.environmentChangesRelaunch": false,
        "terminal.integrated.minimumContrastRatio": 1.0,
        "terminal.integrated.persistentSessionReviveProcess": "never",
        "terminal.integrated.profiles.linux": {
            "custom bash": {
                "args": ["--init-file", "${workspaceFolder:donezone}/.bashrc"],
                "env": { "ZONE": "${workspaceFolder:donezone}" },
                "icon": "terminal-bash",
                "path": "/usr/bin/bash",
            },
        },
        "terminal.integrated.shellIntegration.enabled": false,
        "window.commandCenter": false,
        "window.title": "${dirty}${remoteName}",
        "workbench.startupEditor": "none",
    },
}
